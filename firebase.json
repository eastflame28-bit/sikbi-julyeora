{
  "hosting": {
    "public": "public",
    "ignore": ["**/.*"],
    "headers": [
      { "source": "**/*.@(js|css|svg|png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
